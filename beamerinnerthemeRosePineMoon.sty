% beamerinnerthemeRosePineMoon.sty
% Inner layout of the full variant: circle bullets, numbered table of
% contents with shaded entries, numbered captions. Item colours come from the
% shared colour theme.
\ProvidesPackage{beamerinnerthemeRosePineMoon}[2026/11/12 v2.0 Rosé Pine Moon Inner]
\mode<presentation>

\useinnertheme{circles}

\setbeamertemplate{enumerate items}[default]
\setbeamertemplate{bibliography item}[text]
\setbeamertemplate{caption}[numbered]

% Table of contents: numbered sections and subsections, others shaded
\setbeamertemplate{section in toc}[sections numbered]
\setbeamertemplate{subsection in toc}[subsections numbered]
\setbeamertemplate{section in toc shaded}[default][40]
\setbeamertemplate{subsection in toc shaded}[default][10]
\addtobeamertemplate{section in toc}{}{\vspace*{2pt}}
\addtobeamertemplate{subsection in toc}{}{\vspace*{1pt}}

\mode<all>
